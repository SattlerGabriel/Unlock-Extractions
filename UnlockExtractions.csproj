<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>UnlockExtractions</AssemblyName>
    <!-- Folder containing SPTarkov.Server.Core.dll; override with -p:SptPath=... -->
    <SptPath Condition="'$(SptPath)' == ''">/run/media/fiumbo/SSD1/Wine Prefixes/SPT-Prefix/drive_c/SPT/SPT_Runtime</SptPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(SptPath)/SPTarkov.Server.Core.dll" Private="false" />
    <Reference Include="$(SptPath)/SPTarkov.DI.dll" Private="false" />
    <Reference Include="$(SptPath)/SPTarkov.Common.dll" Private="false" />
    <Reference Include="$(SptPath)/SemanticVersioning.dll" Private="false" />
    <None Include="config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
